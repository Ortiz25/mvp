# /home/admin/apps/captive-portal/backend/.env  (production)
NODE_ENV=production
PORT=3000
MIKROTIK_MOCK=false            # MUST be false — we are not using MikroTik API

# MariaDB for portal app (sessions, campaigns)
DB_HOST=localhost
DB_PORT=3306
DB_USER=portal
DB_PASS=YOUR_PORTAL_DB_PASS
DB_NAME=citynet_portal

# MariaDB for RADIUS (radcheck writes)
RADIUS_DB_HOST=localhost
RADIUS_DB_PORT=3306
RADIUS_DB_USER=radius
RADIUS_DB_PASS=YOUR_RADIUS_DB_PASS
RADIUS_DB_NAME=radius

# CoovaChilli
CHILLI_QUERY_CMD=sudo chilli_query -s /var/run/chilli.ipc
UAM_SECRET=citynet_uam_secret    # Must match HS_UAMSECRET in /etc/chilli/config

ADMIN_TOKEN=your_strong_admin_token_here